// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Participant {
  id              Int      @id @default(autoincrement())
  titre           String   // Monsieur / Madame
  prenom          String
  nom             String
  telephone       String   @unique
  email           String   @unique
  profession      String
  fonction        String
  organisation    String
  ville           String
  niveauEtude     String
  dateInscription DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  acceptTerms     Boolean  @default(false)
  hasPayed        Boolean  @default(false)
  refTransaction  String   @unique @default("")
  
  @@map("participants")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  nom       String
  email     String
  telephone String?
  sujet     String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}

model NewsletterSubscription {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletter_subscriptions")
}

model Article {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  category  String
  date      String
  readTime  String
  title     String
  excerpt   String
  image     String
  intro     String
  body      String
  quote     String
  author    String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("articles")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  fullName     String?
  passwordHash String
  role         String   @default("admin")
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}
